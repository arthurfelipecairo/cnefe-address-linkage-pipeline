# Exemplo para uma implantacao protegida do Elasticsearch.
# O compose.yaml local nao carrega estas credenciais porque usa seguranca
# desativada e expoe a porta somente em 127.0.0.1.
ELASTICSEARCH_URL=https://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD_FILE=/run/secrets/elasticsearch_password
ELASTICSEARCH_CA_CERTS=/run/secrets/http_ca.crt
ELASTICSEARCH_VERIFY_CERTS=true

# Parametros ajustaveis da vinculacao.
ELASTICSEARCH_INDEX=cnefe-enderecos-v1
INDEX_RELEVANT_MUNICIPALITIES_ONLY=true
INDEX_BATCH_SIZE=1000
MATCH_CANDIDATE_SIZE=20
MATCH_MIN_SCORE=70
MATCH_MIN_MARGIN=2
SPARK_DRIVER_MEMORY=2g
SPARK_STREAM_PARTITIONS=128
